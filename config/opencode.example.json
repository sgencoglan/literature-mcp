{
  "mcp": {
    "servers": {
      "sciencedirect-meta": {
        "type": "local",
        "command": [
          "<repo>/.venv/bin/sciencedirect-meta-mcp"
        ],
        "environment": {
          "LIT_PROJECTS_REGISTRY": "<home>/.literature-mcp/projects.json",
          "PAPER_LIBRARY_DIR": "<home>/Documents/papers",
          "REVIEW_OUTPUT_DIR": "<home>/Documents/reviews",
          "JOURNAL_RANK_CSV": "<repo>/packages/sciencedirect-meta/data/scimagojr_2024.csv.gz",
          "CROSSREF_MAILTO": "<email>"
        }
      },
      "paperqa-local": {
        "type": "local",
        "command": [
          "<repo>/.venv/bin/python",
          "<repo>/packages/paperqa-local/paperqa_mcp.py"
        ],
        "environment": {
          "LIT_PROJECTS_REGISTRY": "<home>/.literature-mcp/projects.json",
          "PAPERQA_INDEX_ROOT": "<home>/.literature-mcp/indexes",
          "PAPERQA_PROJECTS_ROOT": "<home>/.literature-mcp/projects",
          "CROSSREF_MAILTO": "<email>"
        }
      }
    }
  }
}
