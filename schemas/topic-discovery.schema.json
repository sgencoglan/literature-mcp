{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sgencoglan/literature-mcp/schemas/topic-discovery.schema.json",
  "title": "Konu, çalışma başlığı ve amaç keşfi",
  "type": "object",
  "required": ["project", "title", "topic", "generated_at", "database_searches", "proposals", "limitations"],
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "scope": { "type": "string" },
    "database_searches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["database", "query", "status", "result_count"],
        "properties": {
          "database": { "enum": ["openalex", "pubmed", "europepmc", "crossref", "other"] },
          "database_label": { "type": "string" },
          "query": { "type": "string", "minLength": 1 },
          "searched_at": { "type": "string" },
          "status": { "enum": ["ok", "error", "not_searched"] },
          "result_count": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rank", "proposed_title", "research_question", "aim", "objectives", "population_context", "suggested_design", "gap_type", "novelty_opportunity", "novelty_signal", "closest_studies", "feasibility_notes", "ranking_rationale"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "proposed_title": { "type": "string", "minLength": 1 },
          "research_question": { "type": "string", "minLength": 1 },
          "aim": { "type": "string", "minLength": 1 },
          "objectives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "population_context": { "type": "string", "minLength": 1 },
          "suggested_design": { "type": "string", "minLength": 1 },
          "gap_type": { "enum": ["population_context", "method", "outcome", "contradictory_findings", "replication", "synthesis", "other"] },
          "novelty_opportunity": { "type": "string", "minLength": 1 },
          "novelty_signal": { "enum": ["weak", "moderate", "strong"] },
          "closest_studies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "relevance"],
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
                "database": { "type": "string" },
                "relevance": { "type": "string", "minLength": 1 },
                "limitation": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "feasibility_notes": { "type": "string", "minLength": 1 },
          "ranking_rationale": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "next_step": { "type": "string" }
  },
  "additionalProperties": true
}
