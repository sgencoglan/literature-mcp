{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sgencoglan/literature-mcp/schemas/writing-plan.schema.json",
  "title": "Yazım planı (iskelet)",
  "description": "Akış 2 çıktısı: alt başlık iskeleti, her başlığın amacı, hedef kelime sayısı ve gereken kanıt türü. Akış 3 bu plana göre arama yapar ve kaynak atar.",
  "type": "object",
  "required": [
    "schema",
    "project",
    "title",
    "genre",
    "target_total_words",
    "sections"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "writing-plan/1"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string"
    },
    "genre": {
      "type": "string",
      "enum": [
        "kitap_bolumu",
        "uygulama_rehberi",
        "derleme_makale",
        "ampirik_makale"
      ],
      "description": "Ürün türü. Varsayılan yoktur; akış 1'de kullanıcı seçer."
    },
    "genre_note": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "target_total_words": {
      "type": "integer",
      "minimum": 300
    },
    "scope_in": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_out": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ],
      "default": "draft",
      "description": "Kullanıcı iskeleti onaylamadan 'approved' yapılmaz; akış 3 onay ister."
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "heading",
          "purpose",
          "target_words",
          "evidence_needs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{1,3}$"
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "target_words": {
            "type": "integer",
            "minimum": 50
          },
          "evidence_needs": {
            "type": "array",
            "description": "Bu başlığı savunmak için gereken en az kanıt türleri.",
            "items": {
              "type": "object",
              "required": [
                "design"
              ],
              "properties": {
                "design": {
                  "type": "string",
                  "enum": [
                    "systematic_review",
                    "meta_analysis",
                    "rct",
                    "quasi_experimental",
                    "cohort",
                    "cross_sectional",
                    "qualitative",
                    "policy_document",
                    "any"
                  ]
                },
                "min_count": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "assigned_dois": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^10\\.\\d{4,9}/\\S+$"
            },
            "description": "Akış 3 doldurur."
          },
          "gap_note": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "covered",
              "gap"
            ],
            "description": "Akış 3 atama sonrası günceller."
          }
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "description": "Akış 3 doldurur: kanıt bulunamayan alt başlıklar.",
      "items": {
        "type": "object",
        "properties": {
          "section_id": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "word_budget": {
      "type": "object",
      "properties": {
        "sections_total": {
          "type": "integer"
        },
        "target_total_words": {
          "type": "integer"
        },
        "planned_section_words": {
          "type": "integer"
        }
      }
    },
    "anchor_terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Bölümün kavramsal çekirdeğinin literatürdeki adları (örn. 'de-escalation', 'escalation cycle', 'crisis prevention'). Bu terimler search_terms içinde geçmek zorundadır; geçmiyorsa toplama aşaması kavramı hiç aramaz."
    },
    "anchor_terms_note": {
      "type": "string",
      "description": "Anchor terimlerin kullanıcı çerçevesinden nasıl türetildiği."
    }
  }
}
