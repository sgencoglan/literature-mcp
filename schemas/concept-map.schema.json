{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sgencoglan/literature-mcp/schemas/concept-map.schema.json",
  "title": "Kavram haritası — başlıktan arama stratejisine",
  "description": "Bir bölümün kavramsal çekirdeğini görünür kılar. Akış 1'de başlıktan çıkarılır, akış 2'de alt başlıklara bağlanır, akış 3'te sorgulara ve kaynak kapsamına dönüşür. Amaç: kullanıcının Türkçe ifadesinin alanyazındaki terimi kaybetmesini engellemek.",
  "type": "object",
  "required": ["schema", "project", "title", "phase", "generated_at", "concepts"],
  "properties": {
    "schema": { "const": "concept-map/1" },
    "project": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "1 = keşif (başlıktan kavram çıkarma), 2 = plana bağlama, 3 = sorgu ve kapsam."
    },
    "generated_at": { "type": "string" },
    "genre": { "type": "string" },
    "user_framing": {
      "type": "string",
      "description": "Kullanıcının kendi ifadesi. Kavram çıkarımının kaynağı."
    },
    "derivation_note": { "type": "string" },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "term", "role"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]{1,3}$" },
          "term": { "type": "string", "minLength": 1, "description": "Türkçe etiket." },
          "role": {
            "enum": ["anchor", "component", "context", "outcome"],
            "description": "anchor = bölümün çekirdeği; component = yapı taşı; context = bağlam; outcome = sonuç."
          },
          "english_terms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Alanyazındaki İngilizce karşılıklar; arama bu terimlerle yapılır."
          },
          "synonyms": { "type": "array", "items": { "type": "string" } },
          "variants": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Yazım varyantları: example-term / exampleterm / example term."
          },
          "mesh": { "type": "array", "items": { "type": "string" } },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "target"],
              "properties": {
                "type": { "enum": ["broader", "narrower", "related", "contrasts_with"] },
                "target": { "type": "string", "pattern": "^C[0-9]{1,3}$" },
                "note": { "type": "string" }
              }
            }
          },
          "source": {
            "enum": ["user_stated", "derived", "literature"],
            "description": "user_stated = kullanıcı söyledi; derived = başlıktan çıkarıldı; literature = alanyazın taramasında belirdi."
          },
          "definition_scope": {
            "type": "string",
            "description": "Kavramın bu bölümde hangi anlamda kullanıldığı ve hangi anlamda kullanılmadığı."
          },
          "sections": {
            "type": "array",
            "items": { "type": "string", "pattern": "^S[0-9]{1,3}$" },
            "description": "Akış 2: bu kavramı besleyen alt başlıklar."
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["query"],
              "properties": {
                "query": { "type": "string", "minLength": 1 },
                "databases": { "type": "array", "items": { "type": "string" } },
                "note": { "type": "string" },
                "status": { "enum": ["ok", "error", "not_run"] },
                "result_count": { "type": ["integer", "null"], "minimum": 0 },
                "found_by": { "type": "array", "items": { "type": "string" } }
              }
            },
            "description": "Akış 3: bu kavram için çalıştırılan sorgular."
          },
          "coverage": {
            "type": "object",
            "properties": {
              "pool_records": { "type": ["integer", "null"], "minimum": 0 },
              "assigned_records": { "type": ["integer", "null"], "minimum": 0 },
              "pdf_with_term": { "type": ["integer", "null"], "minimum": 0 },
              "status": { "enum": ["covered", "partial", "missing", "not_checked"] }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "section_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "heading", "concept_ids"],
        "properties": {
          "section_id": { "type": "string" },
          "heading": { "type": "string" },
          "concept_ids": { "type": "array", "items": { "type": "string" } },
          "has_anchor": { "type": "boolean" },
          "status": { "enum": ["ok", "concept_missing", "anchor_missing"] }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "next_actions": { "type": "array", "items": { "type": "string" } }
  }
}
