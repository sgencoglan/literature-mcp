{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sgencoglan/literature-mcp/schemas/study-design.schema.json",
  "title": "Seçilen çalışma başlığı için araştırma tasarımı",
  "type": "object",
  "required": ["project", "title", "generated_at", "selected_proposal", "design_status", "assumptions", "research_questions", "aim", "objectives", "design_rationale", "design", "population", "sampling", "sample_size", "variables", "measures", "procedure", "analysis", "ethics", "feasibility", "limitations", "decisions_for_user"],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "selected_proposal": {
      "type": "object", "required": ["rank", "proposed_title"],
      "properties": {"rank": {"type": "integer", "minimum": 1}, "proposed_title": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "design_status": {"enum": ["proposed", "user_review", "approved"]},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "research_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "aim": {"type": "string", "minLength": 1},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "design_rationale": {"type": "string", "minLength": 1},
    "design": {"type": "object", "required": ["approach", "design_type", "setting", "timeframe"], "properties": {"approach": {"type": "string"}, "design_type": {"type": "string"}, "setting": {"type": "string"}, "timeframe": {"type": "string"}}, "additionalProperties": true},
    "population": {"type": "object", "required": ["target", "inclusion", "exclusion"], "properties": {"target": {"type": "string"}, "inclusion": {"type": "array", "items": {"type": "string"}}, "exclusion": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "sampling": {"type": "object", "required": ["strategy", "recruitment"], "properties": {"strategy": {"type": "string"}, "recruitment": {"type": "string"}}, "additionalProperties": true},
    "sample_size": {"type": "object", "required": ["target", "rationale"], "properties": {"target": {"type": "string"}, "rationale": {"type": "string"}}, "additionalProperties": true},
    "variables": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "role", "operationalization"], "properties": {"name": {"type": "string"}, "role": {"type": "string"}, "operationalization": {"type": "string"}}, "additionalProperties": true}},
    "measures": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["construct", "instrument_or_method", "caveat"], "properties": {"construct": {"type": "string"}, "instrument_or_method": {"type": "string"}, "caveat": {"type": "string"}, "source_url": {"type": "string", "format": "uri"}}, "additionalProperties": true}},
    "procedure": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["stage", "description"], "properties": {"stage": {"type": "string"}, "description": {"type": "string"}}, "additionalProperties": true}},
    "analysis": {"type": "object", "required": ["quantitative", "qualitative", "integration"], "properties": {"quantitative": {"type": "array", "items": {"type": "string"}}, "qualitative": {"type": "array", "items": {"type": "string"}}, "integration": {"type": "string"}}, "additionalProperties": true},
    "ethics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "feasibility": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decisions_for_user": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "array", "items": {"type": "object", "required": ["title", "url", "relevance"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "relevance": {"type": "string"}}, "additionalProperties": true}}
  },
  "additionalProperties": true
}
